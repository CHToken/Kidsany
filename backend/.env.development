# ===================================
# DEVELOPMENT ENVIRONMENT
# ===================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_dev_password
DB_DATABASE=kidsany_dev_db

# TypeORM Configuration
# AUTO-SYNC ENABLED FOR DEVELOPMENT
TYPEORM_SYNC=true
TYPEORM_LOGGING=true

# JWT Authentication
# Use weak secrets in development for easy testing
JWT_SECRET=dev_jwt_secret_not_for_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev_refresh_secret_not_for_production
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Configuration
COOKIE_SECRET=dev_cookie_secret
COOKIE_SECURE=false

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Email Service (Optional - disabled in development)
SENDGRID_API_KEY=
EMAIL_FROM=dev@kidsany.local
EMAIL_FROM_NAME=Kidsany Dev
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=

# SMS Service (Optional - disabled in development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting (Relaxed for development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=50
OTP_RATE_LIMIT_MAX=30

# Security Settings (Relaxed for development)
BCRYPT_ROUNDS=4
OTP_EXPIRY_MINUTES=30
PASSWORD_RESET_EXPIRY_MINUTES=60

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/dev.log

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Feature Flags (All enabled for testing)
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_FILE_UPLOADS=true

# Development-Specific Features
ENABLE_DEBUG_ROUTES=true
ENABLE_API_DOCS=true
SHOW_STACK_TRACE=true

# Database Seeding (Development/Testing)
ENABLE_SEEDING=true
SEED_PASSWORD=Test1234!

# External Services (Optional)
STRIPE_SECRET_KEY=sk_test_example
STRIPE_PUBLISHABLE_KEY=pk_test_example
GOOGLE_ANALYTICS_ID=
