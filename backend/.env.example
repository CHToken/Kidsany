# ===================================
# KIDSANY PARENT DASHBOARD - BACKEND
# Environment Configuration Template
# ===================================

# Server Configuration
# --------------------
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# ------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_DATABASE=kidsany_db

# TypeORM Configuration
# ---------------------
# Automatically synchronize database schema with entities in development
# WARNING: Set to 'false' in production to prevent data loss
TYPEORM_SYNC=true
TYPEORM_LOGGING=false

# JWT Authentication
# ------------------
# Generate a secure random string for JWT_SECRET using:
# openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# JWT Refresh Token
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Configuration
# --------------------
# Generate a secure random string for COOKIE_SECRET using:
# openssl rand -base64 32
COOKIE_SECRET=your_cookie_secret_here

# Frontend Configuration
# ----------------------
FRONTEND_URL=http://localhost:5173

# Email Service Configuration (Optional)
# ---------------------------------------
# For SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@kidsany.com
EMAIL_FROM_NAME=Kidsany Parent Dashboard

# For SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SMS Service Configuration (Optional)
# -------------------------------------
# For Twilio (OTP delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# File Upload Configuration (Optional)
# -------------------------------------
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# For AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=kidsany-uploads

# For Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting Configuration
# ---------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_MAX=3

# Security Settings
# -----------------
BCRYPT_ROUNDS=10
OTP_EXPIRY_MINUTES=5
PASSWORD_RESET_EXPIRY_MINUTES=15

# Logging Configuration
# ---------------------
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Redis Configuration (Optional - for caching)
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Feature Flags
# -------------
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_FILE_UPLOADS=false

# External Services (Optional)
# -----------------------------
# Payment Gateway
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Analytics
GOOGLE_ANALYTICS_ID=
