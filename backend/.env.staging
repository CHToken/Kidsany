# ===================================
# STAGING ENVIRONMENT
# ===================================

# Server Configuration
PORT=5000
NODE_ENV=staging

# Database Configuration (PostgreSQL)
# Use staging database server
DB_HOST=staging-db.example.com
DB_PORT=5432
DB_USERNAME=kidsany_staging
DB_PASSWORD=your_staging_db_password_here
DB_DATABASE=kidsany_staging_db

# TypeORM Configuration
# DO NOT AUTO-SYNC IN STAGING - USE MIGRATIONS
TYPEORM_SYNC=false
TYPEORM_LOGGING=true

# JWT Authentication
# Use strong secrets - generate with: openssl rand -base64 32
JWT_SECRET=your_staging_jwt_secret_replace_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_staging_refresh_secret_replace_me
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Configuration
COOKIE_SECRET=your_staging_cookie_secret_replace_me
COOKIE_SECURE=true

# Frontend Configuration
FRONTEND_URL=https://staging.kidsany.com

# Email Service (Production-like but to test emails)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=staging@kidsany.com
EMAIL_FROM_NAME=Kidsany Staging
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_password

# SMS Service (Production-like but to test phones)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# AWS S3 (Staging bucket)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=kidsany-staging-uploads

# Cloudinary (Staging account)
CLOUDINARY_CLOUD_NAME=your_staging_cloud
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting (Production-like)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_MAX=3

# Security Settings (Production-like)
BCRYPT_ROUNDS=10
OTP_EXPIRY_MINUTES=5
PASSWORD_RESET_EXPIRY_MINUTES=15

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/staging.log

# Redis Configuration (Optional)
REDIS_HOST=staging-redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Feature Flags (Test production-like behavior)
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_FILE_UPLOADS=true

# Staging-Specific Features
ENABLE_DEBUG_ROUTES=true
ENABLE_API_DOCS=true
SHOW_STACK_TRACE=true

# External Services
STRIPE_SECRET_KEY=sk_test_staging_key
STRIPE_PUBLISHABLE_KEY=pk_test_staging_key
GOOGLE_ANALYTICS_ID=UA-STAGING-123
